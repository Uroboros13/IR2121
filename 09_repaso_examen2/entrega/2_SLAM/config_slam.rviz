Panels:
- Class: rviz_common/Displays
  Help Height: 0
  Name: Displays
  Property Tree Widget:
    Expanded: null
    Splitter Ratio: 0.5
  Tree Height: 300
- Class: rviz_common/Views
  Expanded:
  - /Current View1
  Name: Views
  Splitter Ratio: 0.5
- Class: rviz_common/Time
  Experimental: false
  Name: Time
  SyncMode: 0
  SyncSource: ''
Visualization Manager:
  Class: ''
  Displays:
  - Class: rviz_default_plugins/Grid
    Name: Grid
    Enabled: true
    Value: true
    Cell Size: 1
    Plane Cell Count: 10
    Reference Frame: <Fixed Frame>
    Color: 160; 160; 164
    Alpha: 0.5
    Line Style:
      Line Width: 0.03
      Value: Lines
    Plane: XY
    Normal Cell Count: 0
    Offset:
      X: 0
      Y: 0
      Z: 0
  - Class: rviz_default_plugins/Odometry
    Name: Odometry
    Enabled: true
    Value: true
    Topic:
      Value: /odom
      Depth: 5
      History Policy: Keep Last
      Reliability Policy: Reliable
      Durability Policy: Volatile
      Filter size: 10
    Keep: 100
    Position Tolerance: 0.1
    Angle Tolerance: 0.1
    Shape:
      Value: Arrow
      Color: 255; 25; 0
      Alpha: 1
      Shaft Length: 0.3
      Shaft Radius: 0.02
      Head Length: 0.1
      Head Radius: 0.05
    Covariance:
      Value: false
  - Class: rviz_default_plugins/LaserScan
    Name: LaserScan
    Enabled: true
    Value: true
    Topic:
      Value: /scan
      Depth: 5
      History Policy: Keep Last
      Reliability Policy: Best Effort
      Durability Policy: Volatile
      Filter size: 10
    Style: Flat Squares
    Size (m): 0.05
    Size (Pixels): 3
    Color Transformer: FlatColor
    Color: 0; 255; 0
    Alpha: 1
    Decay Time: 0
    Position Transformer: XYZ
    Selectable: true
    Use Fixed Frame: true
    Use rainbow: true
    Autocompute Intensity Bounds: true
    Channel Name: intensity
    Invert Rainbow: false
    Min Color: 0; 0; 0
    Max Color: 255; 255; 255
  - Class: rviz_default_plugins/RobotModel
    Name: RobotModel
    Enabled: true
    Value: true
    Description Source: Topic
    Description File: ''
    Description Topic:
      Value: /robot_description
      Depth: 5
      History Policy: Keep Last
      Reliability Policy: Reliable
      Durability Policy: Transient Local
    TF Prefix: ''
    Alpha: 1
    Visual Enabled: true
    Collision Enabled: false
    Update Interval: 0
    Mass Properties:
      Inertia: false
      Mass: false
  - Class: rviz_default_plugins/Image
    Name: Image
    Enabled: true
    Value: true
    Topic:
      Value: /camera/image_raw
      Depth: 5
      History Policy: Keep Last
      Reliability Policy: Best Effort
      Durability Policy: Volatile
      Filter size: 10
    Normalize Range: true
    Max Value: 1
    Min Value: 0
    Median window: 5
  - Class: rviz_default_plugins/TF
    Name: TF
    Enabled: true
    Value: true
    Show Names: false
    Show Axes: true
    Show Arrows: false
    Marker Scale: 0.5
    Update Interval: 0
    Frame Timeout: 15
    Frames:
      All Enabled: true
  - Class: rviz_default_plugins/Map
    Name: Map
    Enabled: true
    Value: true
    Topic:
      Value: /map
      Depth: 1
      History Policy: Keep Last
      Reliability Policy: Reliable
      Durability Policy: Transient Local
    Update Topic:
      Value: /map_updates
      Depth: 5
      History Policy: Keep Last
      Reliability Policy: Reliable
      Durability Policy: Volatile
    Color Scheme: map
    Alpha: 0.7
    Draw Behind: false
    Use Timestamp: false
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
  - Class: rviz_default_plugins/Interact
    Hide Inactive Objects: true
  - Class: rviz_default_plugins/MoveCamera
  - Class: rviz_default_plugins/Select
  - Class: rviz_default_plugins/FocusCamera
  - Class: rviz_default_plugins/Measure
    Line color: 128; 128; 0
  - Class: rviz_default_plugins/SetInitialPose
    Covariance x: 0.25
    Covariance y: 0.25
    Covariance yaw: 0.0685
    Topic:
      Value: /initialpose
      Depth: 5
      History Policy: Keep Last
      Reliability Policy: Reliable
      Durability Policy: Volatile
  - Class: rviz_default_plugins/SetGoal
    Topic:
      Value: /goal_pose
      Depth: 5
      History Policy: Keep Last
      Reliability Policy: Reliable
      Durability Policy: Volatile
  - Class: rviz_default_plugins/PublishPoint
    Single click: true
    Topic:
      Value: /clicked_point
      Depth: 5
      History Policy: Keep Last
      Reliability Policy: Reliable
      Durability Policy: Volatile
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Angle: 0
      Enable Stereo Rendering:
        Stereo Eye Separation: 0.06
        Stereo Focal Distance: 1
        Swap Stereo Eyes: false
        Value: false
      Invert Z Axis: false
      Name: Current View
      Near Clip Distance: 0.01
      Scale: 80
      Target Frame: <Fixed Frame>
      Value: TopDownOrtho (rviz_default_plugins)
      X: 0
      Y: 0
    Saved: null
Window Geometry:
  Displays:
    collapsed: false
  Height: 900
  Width: 1400
  Hide Left Dock: false
  Hide Right Dock: true
  Image:
    collapsed: false
  Time:
    collapsed: false
  Views:
    collapsed: true
  Selection:
    collapsed: false
  Tool Properties:
    collapsed: false
  X: 60
  Y: 60
